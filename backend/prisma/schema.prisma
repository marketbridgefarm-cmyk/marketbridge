generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
 
enum Role {
  SELLER
  BUYER
  INSPECTOR
  TRUCK_OWNER
  ADVERTISER
  ADMIN
}

enum ListingCategory {
  AGRICULTURAL
  PRODUCT
  DIGITAL
}

enum ListingStatus {
  DRAFT
  ACTIVE
  UNDER_NEGOTIATION
  SOLD
  CANCELLED
}

enum OfferStatus {
  PENDING
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum InspectionMode {
  SELLER_REQUESTED
  BUYER_REQUESTED
  JOINT
}

enum InspectionStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  TRANSPORT_ARRANGED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum ArrangingParty {
  SELLER
  BUYER
  JOINT
}

enum TransportMethod {
  OWN_TRUCK
  HIRE_TRANSPORTER
}

enum TransportStatus {
  REQUESTED
  ACCEPTED
  QUOTED
  PICKUP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum TransportQuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum TruckAvailability {
  AVAILABLE
  BUSY
  OFFLINE
}

enum PaymentType {
  MARKETPLACE
  TRANSPORT
  INSPECTOR
  ADVERTISING
  DIGITAL
}

enum DigitalPurchaseStatus {
  PENDING
  COMPLETED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  TELEBIRR
  CBE
  QR
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AdType {
  FEATURED_LISTING
  TOP_OF_CATEGORY
  SPONSORED_SEARCH
  BANNER
  TELEGRAM_PROMOTION
}

enum AdStatus {
  PENDING
  ACTIVE
  EXPIRED
  REJECTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  phone String?
  passwordHash String
  roles Role[] @default([BUYER, SELLER])
  location String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  rating Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listings Listing[] @relation("SellerListings")
  offersMade Offer[] @relation("BuyerOffers")
  inspectionsRequested InspectionRequest[] @relation("Requester")
  inspectionsPerformed InspectionRequest[] @relation("Inspector")
  trucks Truck[]
  ordersAsBuyer Order[] @relation("BuyerOrders")
  ordersAsSeller Order[] @relation("SellerOrders")
  transportJobsHauled TransportJob[] @relation("TruckOwnerJobs")
  transportQuotes TransportQuote[] @relation("TruckOwnerQuotes")
  digitalProducts DigitalProduct[]
  ads Advertisement[]
  ratingsGiven Rating[] @relation("RatingsGiven")
  ratingsReceived Rating[] @relation("RatingsReceived")
  messagesSent Message[] @relation("MessagesSent")
  messagesReceived Message[] @relation("MessagesReceived")
  disputesRaised Dispute[] @relation("DisputeRaisedBy")
  disputesAgainst Dispute[] @relation("DisputeAgainst")
  paymentsCreated Payment[] @relation("PaymentCreatedBy")
  digitalPurchases DigitalPurchase[] @relation("DigitalPurchases")
}

model Listing {
  id String @id @default(uuid())
  seller User @relation("SellerListings", fields: [sellerId], references: [id])
  sellerId String
  category ListingCategory @default(AGRICULTURAL)
  title String?
  cropType String?
  quantity Float
  unit String
  askingPrice Float
  minAcceptablePrice Float?
  location String
  harvestedDate DateTime?
  readinessDate DateTime?
  photos String[]
  videos String[]
  description String?
  status ListingStatus @default(DRAFT)
  createdByInspectorId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  offers Offer[]
  inspectionRequests InspectionRequest[]
  orders Order[]
  ads Advertisement[]
  @@index([sellerId])
  @@index([category])
  @@index([status])
  @@index([location])
}

model Offer {
  id String @id @default(uuid())
  listing Listing @relation(fields: [listingId], references: [id])
  listingId String
  buyer User @relation("BuyerOffers", fields: [buyerId], references: [id])
  buyerId String
  amount Float
  status OfferStatus @default(PENDING)
  counterAmount Float?
  message String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([listingId])
  @@index([buyerId])
  @@index([status])
}

model InspectionRequest {
  id String @id @default(uuid())
  listing Listing @relation(fields: [listingId], references: [id])
  listingId String
  requestedBy User @relation("Requester", fields: [requestedById], references: [id])
  requestedById String
  mode InspectionMode
  inspector User? @relation("Inspector", fields: [inspectorId], references: [id])
  inspectorId String?
  status InspectionStatus @default(REQUESTED)
  fee Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  report InspectionReport?
  @@index([listingId])
  @@index([requestedById])
  @@index([inspectorId])
  @@index([status])
}

model InspectionReport {
  id String @id @default(uuid())
  request InspectionRequest @relation(fields: [requestId], references: [id])
  requestId String @unique
  quantity Float
  grade String?
  moisture Float?
  visibleDefects String?
  damageNotes String?
  packagingNotes String?
  photos String[]
  videos String[]
  gpsLocation String?
  inspectedAt DateTime @default(now())
}

model Order {
  id String @id @default(uuid())
  listing Listing @relation(fields: [listingId], references: [id])
  listingId String
  buyer User @relation("BuyerOrders", fields: [buyerId], references: [id])
  buyerId String
  seller User @relation("SellerOrders", fields: [sellerId], references: [id])
  sellerId String
  finalPrice Float
  status OrderStatus @default(PENDING_PAYMENT)
  arrangingParty ArrangingParty?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transportJob TransportJob?
  payments Payment[]
  disputes Dispute[]
  ratings Rating[]
  messages Message[]
  @@index([buyerId])
  @@index([sellerId])
  @@index([listingId])
  @@index([status])
}

model Truck {
  id String @id @default(uuid())
  owner User @relation(fields: [ownerId], references: [id])
  ownerId String
  registration String
  truckType String
  capacity Float
  operatingArea String
  availability TruckAvailability @default(AVAILABLE)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  rating Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transportJobs TransportJob[]
  transportQuotes TransportQuote[]
  @@index([ownerId])
  @@index([availability])
  @@index([operatingArea])
  @@index([registration])
}

model TransportJob {
  id String @id @default(uuid())
  order Order @relation(fields: [orderId], references: [id])
  orderId String @unique
  arrangingParty ArrangingParty
  method TransportMethod
  truckOwner User? @relation("TruckOwnerJobs", fields: [truckOwnerId], references: [id])
  truckOwnerId String?
  truck Truck? @relation(fields: [truckId], references: [id])
  truckId String?
  pickupLocation String
  destination String
  load String
  requiredCapacity Float?
  specialRequirements String?
  agreedAmount Float?
  status TransportStatus @default(REQUESTED)
  pickupConfirmedAt DateTime?
  deliveredConfirmedAt DateTime?
  incidentNotes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quotes TransportQuote[]
  @@index([truckOwnerId])
  @@index([truckId])
  @@index([status])
  @@index([method])
}

model TransportQuote {
  id String @id @default(uuid())
  transportJob TransportJob @relation(fields: [transportJobId], references: [id])
  transportJobId String
  truckOwner User @relation("TruckOwnerQuotes", fields: [truckOwnerId], references: [id])
  truckOwnerId String
  truck Truck @relation(fields: [truckId], references: [id])
  truckId String
  amount Float
  status TransportQuoteStatus @default(PENDING)
  message String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([transportJobId])
  @@index([truckOwnerId])
  @@index([truckId])
  @@index([status])
  @@unique([transportJobId, truckOwnerId, truckId])
}

model DigitalProduct {
  id String @id @default(uuid())
  seller User @relation(fields: [sellerId], references: [id])
  sellerId String
  title String
  productType String
  price Float
  // Private object-storage key. New products must have this set.
  fileKey String?
  fileName String?
  mimeType String?
  fileSizeBytes Int?
  // Legacy field retained only for migration/reference; never exposed or redirected.
  fileUrl String?
  description String?
  status ListingStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments Payment[]
  digitalPurchases DigitalPurchase[]
  @@index([sellerId])
  @@index([status])
}

model Payment {
  id String @id @default(uuid())
  order Order? @relation(fields: [orderId], references: [id])
  orderId String?
  createdBy User? @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdById String?
  digitalProduct DigitalProduct? @relation(fields: [digitalProductId], references: [id])
  digitalProductId String?
  advertisement Advertisement? @relation(fields: [advertisementId], references: [id])
  advertisementId String?
  digitalPurchase DigitalPurchase?
  type PaymentType
  amount Float
  method PaymentMethod
  status PaymentStatus @default(PENDING)
  reference String?
  provider String?
  providerTransactionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orderId])
  @@index([createdById])
  @@index([digitalProductId])
  @@index([advertisementId])
  @@index([type])
  @@index([status])
  @@index([reference])
  @@unique([provider, providerTransactionId])
}

model DigitalPurchase {
  id String @id @default(uuid())
  product DigitalProduct @relation(fields: [productId], references: [id])
  productId String
  buyer User @relation("DigitalPurchases", fields: [buyerId], references: [id])
  buyerId String
  payment Payment @relation(fields: [paymentId], references: [id])
  paymentId String @unique
  status DigitalPurchaseStatus @default(PENDING)
  downloadCount Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([productId, buyerId])
  @@index([buyerId])
  @@index([productId])
  @@index([status])
}

model Advertisement {
  id String @id @default(uuid())
  advertiser User @relation(fields: [advertiserId], references: [id])
  advertiserId String
  listing Listing? @relation(fields: [listingId], references: [id])
  listingId String?
  type AdType
  status AdStatus @default(PENDING)
  startDate DateTime
  endDate DateTime
  amountPaid Float?
  payments Payment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([advertiserId])
  @@index([listingId])
  @@index([status])
}

model Dispute {
  id String @id @default(uuid())
  order Order @relation(fields: [orderId], references: [id])
  orderId String
  raisedBy User @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  raisedById String
  against User @relation("DisputeAgainst", fields: [againstId], references: [id])
  againstId String
  disputeType String
  description String
  evidence String[]
  status DisputeStatus @default(OPEN)
  resolution String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orderId])
  @@index([raisedById])
  @@index([againstId])
  @@index([status])
}

model Rating {
  id String @id @default(uuid())
  order Order @relation(fields: [orderId], references: [id])
  orderId String
  fromUser User @relation("RatingsGiven", fields: [fromUserId], references: [id])
  fromUserId String
  toUser User @relation("RatingsReceived", fields: [toUserId], references: [id])
  toUserId String
  role Role
  score Int
  comment String?
  createdAt DateTime @default(now())
  @@index([orderId])
  @@index([fromUserId])
  @@index([toUserId])
  @@unique([orderId, fromUserId, toUserId, role])
}

model Message {
  id String @id @default(uuid())
  order Order? @relation(fields: [orderId], references: [id])
  orderId String?
  sender User @relation("MessagesSent", fields: [senderId], references: [id])
  senderId String
  receiver User @relation("MessagesReceived", fields: [receiverId], references: [id])
  receiverId String
  content String
  createdAt DateTime @default(now())
  @@index([orderId])
  @@index([senderId])
  @@index([receiverId])
}
