generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  SELLER
  BUYER
  INSPECTOR
  TRUCK_OWNER
  ADVERTISER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum ListingCategory {
  AGRICULTURAL
  PRODUCT
  DIGITAL
}

// Ethiopia's current top-level administrative divisions: 12 regional
// states plus the two federally-chartered city administrations, which
// function the same way for "where is this listing" purposes. Sourced
// from the current (2026) subdivision, including the 2023
// Central/South/South West Ethiopia Peoples' region formations.
// Zone/woreda/kebele are deliberately kept as free-text fields on Listing
// rather than their own enums/lookup tables — Ethiopia has 60+ zones and
// well over a thousand woredas, actively being redrawn, and no reference
// table for them ships with this migration; a region dropdown plus
// free-text zone/woreda/kebele is the practical middle ground until a
// verified administrative dataset is sourced.
enum Region {
  TIGRAY
  AFAR
  AMHARA
  OROMIA
  SOMALI
  BENISHANGUL_GUMUZ
  GAMBELA
  HARARI
  SIDAMA
  SOUTH_ETHIOPIA
  SOUTH_WEST_ETHIOPIA_PEOPLES
  CENTRAL_ETHIOPIA
  ADDIS_ABABA
  DIRE_DAWA
}

enum ListingStatus {
  DRAFT
  ACTIVE
  UNDER_NEGOTIATION
  SOLD
  CANCELLED
  EXPIRED
}

enum OfferStatus {
  PENDING
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum OfferCounterParty {
  BUYER
  SELLER
}

enum InspectionMode {
  SELLER_REQUESTED
  BUYER_REQUESTED
  JOINT
}

enum InspectionStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InspectionQuoteStatus {
  PENDING
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

// Identifies whose turn it is in a quote negotiation.
enum QuoteCounterParty {
  REQUESTER
  PROVIDER
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  TRANSPORT_ARRANGED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum ArrangingParty {
  SELLER
  BUYER
  JOINT
}

enum TransportMethod {
  OWN_TRUCK
  HIRE_TRANSPORTER
}

enum TransportStatus {
  REQUESTED
  ACCEPTED
  QUOTED
  PICKUP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum TransportEvidenceType {
  PICKUP
  DELIVERY
  INCIDENT
}

enum TransportQuoteStatus {
  PENDING
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum TruckAvailability {
  AVAILABLE
  BUSY
  OFFLINE
}

enum PaymentObligationStatus {
  OPEN
  PAID
  CANCELLED
}

enum PaymentType {
  MARKETPLACE
  TRANSPORT
  INSPECTOR
  ADVERTISING
  DIGITAL
}

enum DigitalPurchaseStatus {
  PENDING
  COMPLETED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  TELEBIRR
  CBE
  QR
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  RECONCILIATION_REQUIRED
}

enum AdType {
  FEATURED_LISTING
  TOP_OF_CATEGORY
  SPONSORED_SEARCH
  BANNER
  TELEGRAM_PROMOTION
}

enum AdStatus {
  // Legacy values retained for backwards compatibility.
  PENDING
  ACTIVE

  PENDING_PAYMENT
  PAID_PENDING_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  EXPIRED
  REJECTED
  CANCELLED
}

enum AdvertisementEventType {
  IMPRESSION
  CLICK
}

enum BannerTemplate {
  CLASSIC
  BOLD
  MINIMAL
  CARD
  SPLIT
  EDITORIAL
  FRESH
  DARK_LUXE
  MARKET
  GRADIENT
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ProviderRoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// FINANCIAL LEDGER ENUM
// ============================================================================

enum PaymentRefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentReconciliationStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum PaymentLedgerEntryType {
  SELLER_EARNING
  TRANSPORTER_EARNING
  INSPECTOR_EARNING
  PLATFORM_COMMISSION
  PLATFORM_REVENUE
  REFUND
}

// ============================================================================
// USER
// ============================================================================

model User {
  id String @id @default(uuid())

  name         String
  email        String @unique
  phone        String?
  passwordHash String

  // Normal users can act as both buyer and seller.
  roles Role[] @default([BUYER, SELLER])

  location           String?
  region             Region?
  latitude           Float?
  longitude          Float?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  accountStatus      AccountStatus      @default(ACTIVE)

  // Multi-factor authentication (TOTP). mfaSecret is set as soon as setup
  // begins but only takes effect once mfaEnabled is flipped true by a
  // verified code + password confirmation (see routes/auth.js mfa/*).
  // Backup codes are stored bcrypt-hashed, one-time-use, consumed on use.
  mfaEnabled      Boolean  @default(false)
  mfaSecret       String?
  mfaBackupCodes  String[] @default([])

  // Notification/localization preferences. SMS defaults to off — it costs
  // money per message and needs explicit opt-in, not just a phone number
  // being present. preferredLanguage drives which language SMS bodies (and
  // eventually the frontend UI) are shown in; "en" is the only language
  // guaranteed to be fully translated right now (see frontend/src/i18n).
  smsNotificationsEnabled Boolean @default(false)
  preferredLanguage       String  @default("en")

  smsOutboxEntries SmsOutboxEntry[]

  passwordResetTokens PasswordResetToken[]

  rating Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Listings
  listings Listing[] @relation("SellerListings")

  // Offers
  offersMade     Offer[] @relation("BuyerOffers")
  offersReceived Offer[] @relation("SellerOffers")

  // Inspections
  inspectionsRequested InspectionRequest[] @relation("Requester")
  inspectionsPerformed InspectionRequest[] @relation("Inspector")

  inspectionQuotes InspectionQuote[]

  inspectionEvidenceCreated InspectionEvidence[] @relation("InspectionEvidenceCreator")

  // Trucks
  trucks Truck[]

  // Orders
  ordersAsBuyer  Order[] @relation("BuyerOrders")
  ordersAsSeller Order[] @relation("SellerOrders")

  // Transport
  transportJobsHauled TransportJob[] @relation("TruckOwnerJobs")
  transportQuotes     TransportQuote[] @relation("TruckOwnerQuotes")

  // Digital products
  digitalProducts DigitalProduct[]

  // Advertising
  ads Advertisement[]

  // Ratings
  ratingsGiven    Rating[] @relation("RatingsGiven")
  ratingsReceived Rating[] @relation("RatingsReceived")

  // Messages
  messagesSent     Message[] @relation("MessagesSent")
  messagesReceived Message[] @relation("MessagesReceived")

  // Disputes
  disputesRaised  Dispute[] @relation("DisputeRaisedBy")
  disputesAgainst Dispute[] @relation("DisputeAgainst")

  // Payments
  paymentsCreated Payment[] @relation("PaymentCreatedBy")
  paymentRefundsRequested PaymentRefund[] @relation("PaymentRefundRequestedBy")
  paymentReconciliationsResolved PaymentReconciliation[] @relation("PaymentReconciliationResolvedBy")

  paymentObligationsAsPayer PaymentObligation[] @relation("PaymentObligationPayer")

  paymentObligationsAsBeneficiary PaymentObligation[] @relation("PaymentObligationBeneficiary")

  // Order events
  orderEvents OrderEvent[] @relation("OrderEventActor")

  notifications Notification[]

  refreshSessions RefreshSession[]

  providerRoleRequests ProviderRoleRequest[]

  // Audit
  auditEvents AuditEvent[] @relation("AuditActor")

  transportEvidenceCreated TransportEvidence[] @relation("TransportEvidenceCreator")

  // Digital purchases
  digitalPurchases DigitalPurchase[] @relation("DigitalPurchases")

  // Financial ledger
  ledgerEntries PaymentLedgerEntry[]

  @@index([email])
  @@index([accountStatus])
  @@index([verificationStatus])
  @@index([region])
}


// ============================================================================
// PROVIDER ROLE REQUEST
// ============================================================================

model ProviderRoleRequest {
  id String @id @default(uuid())

  userId String
  role Role
  status ProviderRoleRequestStatus @default(PENDING)
  reviewedById String?
  reviewedAt DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([status])
  @@index([userId])
}


// ============================================================================
// REFRESH SESSION
// ============================================================================

model RefreshSession {
  id String @id @default(uuid())

  userId String
  familyId String
  tokenHash String @unique

  expiresAt DateTime
  lastUsedAt DateTime?
  rotatedAt DateTime?
  revokedAt DateTime?
  revokedReason String?

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId, revokedAt])
  @@index([createdAt])
}

// ============================================================================
// PASSWORD RESET
// ============================================================================
//
// Same pattern as RefreshSession: the raw token is emailed to the user and
// never stored; only its sha256 hash lives here, so a database read alone
// can never be used to reset an account's password.
// ============================================================================

model PasswordResetToken {
  id String @id @default(uuid())

  userId    String
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  requestedIp String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
}

// ============================================================================
// SMS OUTBOX
// ============================================================================
//
// Transactional outbox: rows are written in the same DB transaction as the
// event that triggers them (see services/notificationService.js), so an
// SMS is never queued for an action that ends up rolling back — and the
// actual network send happens later, out-of-transaction, from the
// maintenance scheduler (services/maintenanceService.js sendPendingSms).
// This keeps a flaky/slow SMS provider from ever holding open a DB
// transaction or from touching every call site that records an order event.
// ============================================================================

enum SmsOutboxStatus {
  PENDING
  SENT
  FAILED
}

model SmsOutboxEntry {
  id String @id @default(uuid())

  userId String
  phone  String // denormalized at write time so a later phone-number change doesn't retarget an already-queued message
  body   String

  status   SmsOutboxStatus @default(PENDING)
  attempts Int             @default(0)
  lastError String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

// ============================================================================
// AUDIT EVENT
// ============================================================================

model AuditEvent {
  id String @id @default(uuid())

  actor   User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?

  action       String
  resourceType String
  resourceId   String?

  // Never store passwords, tokens, or secrets here.
  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
}

// ============================================================================
// LISTING
// ============================================================================

model Listing {
  id String @id @default(uuid())

  seller   User   @relation("SellerListings", fields: [sellerId], references: [id])
  sellerId String

  category ListingCategory @default(AGRICULTURAL)

  title    String?
  cropType String?

  quantity          Float
  availableQuantity Float
  unit              String

  askingPrice       Decimal  @db.Decimal(18, 2)
  minAcceptablePrice Decimal? @db.Decimal(18, 2)

  location String

  // Structured Ethiopian geography layered on top of the free-text
  // `location` label above (kept for backward compatibility with
  // existing listings and as a human-readable display string). All
  // optional so existing listings and simple entry flows keep working;
  // populating region+lat/lng is what unlocks the /listings/nearby
  // distance search and the region filter on the main search endpoint.
  region    Region?
  zone      String?
  woreda    String?
  kebele    String?
  latitude  Float?
  longitude Float?

  harvestedDate    DateTime?
  readinessDate    DateTime?
  pickupWindowStart DateTime?
  pickupWindowEnd   DateTime?

  photos String[]
  videos String[]

  description String?

  status ListingStatus @default(DRAFT)

  createdByInspectorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers             Offer[]
  inspectionRequests InspectionRequest[]
  orders             Order[]
  ads                Advertisement[]

  @@index([sellerId])
  @@index([category])
  @@index([status])
  @@index([location])
  @@index([region])
  @@index([latitude, longitude])
  @@index([pickupWindowStart, pickupWindowEnd])
}

// ============================================================================
// OFFER
// ============================================================================

model Offer {
  id String @id @default(uuid())

  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String

  buyer   User   @relation("BuyerOffers", fields: [buyerId], references: [id])
  buyerId String

  seller   User   @relation("SellerOffers", fields: [sellerId], references: [id])
  sellerId String

  amount   Decimal @db.Decimal(18, 2)
  quantity Float?

  // Immutable negotiation chain.
  parentOfferId String?
  parentOffer   Offer?  @relation("OfferChain", fields: [parentOfferId], references: [id])
  childOffers   Offer[] @relation("OfferChain")

  expiresAt DateTime?

  status OfferStatus @default(PENDING)

  counterAmount Decimal? @db.Decimal(18, 2)

  // SELLER = seller most recently countered; buyer responds.
  // BUYER  = buyer most recently countered; seller responds.
  counteredBy OfferCounterParty?

  message String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([counteredBy])
  @@index([parentOfferId])
  @@index([expiresAt])
}

// ============================================================================
// INSPECTION REQUEST
// ============================================================================

model InspectionRequest {
  id String @id @default(uuid())

  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String

  requestedBy   User   @relation("Requester", fields: [requestedById], references: [id])
  requestedById String

  mode InspectionMode

  inspector   User?  @relation("Inspector", fields: [inspectorId], references: [id])
  inspectorId String?

  location String?

  status InspectionStatus @default(REQUESTED)

  fee Decimal? @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report InspectionReport?

  payments Payment[]

  paymentObligations PaymentObligation[]

  quotes InspectionQuote[]

  @@index([listingId])
  @@index([requestedById])
  @@index([inspectorId])
  @@index([status])
  @@index([location])
}

// ============================================================================
// INSPECTION QUOTE
// ============================================================================

model InspectionQuote {
  id String @id @default(uuid())

  inspectionRequest   InspectionRequest @relation(fields: [inspectionRequestId], references: [id])
  inspectionRequestId String

  inspector   User   @relation(fields: [inspectorId], references: [id])
  inspectorId String

  amount Decimal @db.Decimal(18, 2)

  status InspectionQuoteStatus @default(PENDING)

  message String?

  // Immutable negotiation chain.
  parentQuoteId String?

  parentQuote InspectionQuote? @relation("InspectionQuoteChain", fields: [parentQuoteId], references: [id])

  childQuotes InspectionQuote[] @relation("InspectionQuoteChain")

  counterAmount Decimal? @db.Decimal(18, 2)

  // REQUESTER = requester most recently countered.
  // PROVIDER  = inspector most recently countered.
  counteredBy QuoteCounterParty?

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inspectionRequestId])
  @@index([inspectorId])
  @@index([status])
  @@index([parentQuoteId])
  @@index([expiresAt])
}

// ============================================================================
// INSPECTION REPORT
// ============================================================================

model InspectionReport {
  id String @id @default(uuid())

  request   InspectionRequest @relation(fields: [requestId], references: [id])
  requestId String @unique

  quantity Float

  grade          String?
  moisture       Float?
  visibleDefects String?
  damageNotes    String?
  packagingNotes String?

  photos String[]
  videos String[]

  gpsLocation String?

  inspectedAt DateTime @default(now())

  evidence InspectionEvidence[]
}

// ============================================================================
// INSPECTION EVIDENCE
// ============================================================================

model InspectionEvidence {
  id String @id @default(uuid())

  report   InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String

  type String @default("REPORT")

  photos String[]
  videos String[]

  gpsLocation String?
  notes       String?

  capturedAt DateTime @default(now())

  createdById String

  createdBy User @relation("InspectionEvidenceCreator", fields: [createdById], references: [id])

  @@index([reportId, type])
  @@index([createdById, capturedAt])
}

// ============================================================================
// ORDER
// ============================================================================

model Order {
  // Business invariant: a listing may have at most one non-cancelled order.
  // PostgreSQL enforces the conditional uniqueness through migration
  // 202609140004_order_listing_sale_invariant because Prisma cannot express
  // partial unique indexes in the schema DSL.
  id String @id @default(uuid())

  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String

  buyer   User   @relation("BuyerOrders", fields: [buyerId], references: [id])
  buyerId String

  seller   User   @relation("SellerOrders", fields: [sellerId], references: [id])
  sellerId String

  finalPrice Decimal @db.Decimal(18, 2)
  quantity   Float

  status OrderStatus @default(PENDING_PAYMENT)

  arrangingParty ArrangingParty?

  // Automatic inventory release for abandoned/unpaid orders. Set at order
  // creation (buy-now / offer-acceptance) to now + ORDER_PAYMENT_TIMEOUT_HOURS.
  // The maintenance scheduler (maintenanceService.js) cancels any order still
  // PENDING_PAYMENT past this timestamp and returns its reserved quantity to
  // the listing. Null for orders created before this field existed, or for
  // any order that has already moved past PENDING_PAYMENT.
  paymentDueAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transportJob TransportJob?

  payments Payment[]

  // Durable payment obligations for the order.
  paymentObligations PaymentObligation[]

  // Durable customer-facing workflow events.
  events OrderEvent[]

  notifications Notification[]

  disputes Dispute[]

  ratings Rating[]

  messages Message[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([listingId])
  @@index([status])
  @@index([status, paymentDueAt])
}

// ============================================================================
// TRUCK
// ============================================================================

model Truck {
  id String @id @default(uuid())

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  registration String
  truckType    String
  capacity     Float
  operatingArea String

  availability TruckAvailability @default(AVAILABLE)

  verificationStatus VerificationStatus @default(UNVERIFIED)

  rating Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transportJobs   TransportJob[]
  transportQuotes TransportQuote[]

  @@index([ownerId])
  @@index([availability])
  @@index([operatingArea])
  @@index([registration])
}

// ============================================================================
// TRANSPORT JOB
// ============================================================================

model TransportJob {
  id String @id @default(uuid())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String @unique

  arrangingParty ArrangingParty

  method TransportMethod

  truckOwner   User?  @relation("TruckOwnerJobs", fields: [truckOwnerId], references: [id])
  truckOwnerId String?

  truck   Truck? @relation(fields: [truckId], references: [id])
  truckId String?

  pickupLocation String
  destination    String
  load           String

  requiredCapacity Float?

  specialRequirements String?

  agreedAmount Decimal? @db.Decimal(18, 2)

  status TransportStatus @default(REQUESTED)

  pickupConfirmedAt   DateTime?
  deliveredConfirmedAt DateTime?

  incidentNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes TransportQuote[]

  evidence TransportEvidence[]

  payments Payment[]

  paymentObligations PaymentObligation[]

  @@index([truckOwnerId])
  @@index([truckId])
  @@index([status])
  @@index([method])
}

// ============================================================================
// TRANSPORT EVIDENCE
// ============================================================================

model TransportEvidence {
  id String @id @default(uuid())

  transportJob   TransportJob @relation(fields: [transportJobId], references: [id], onDelete: Cascade)
  transportJobId String

  type TransportEvidenceType

  photos String[]
  videos String[]

  gpsLocation String?
  notes       String?

  capturedAt DateTime @default(now())

  createdById String

  createdBy User @relation("TransportEvidenceCreator", fields: [createdById], references: [id])

  @@index([transportJobId, type])
  @@index([createdById, capturedAt])
}

// ============================================================================
// TRANSPORT QUOTE
// ============================================================================

model TransportQuote {
  id String @id @default(uuid())

  transportJob   TransportJob @relation(fields: [transportJobId], references: [id])
  transportJobId String

  truckOwner   User   @relation("TruckOwnerQuotes", fields: [truckOwnerId], references: [id])
  truckOwnerId String

  truck   Truck   @relation(fields: [truckId], references: [id])
  truckId String

  amount Decimal @db.Decimal(18, 2)

  status TransportQuoteStatus @default(PENDING)

  message String?

  // Immutable negotiation chain.
  parentQuoteId String?

  parentQuote TransportQuote? @relation("TransportQuoteChain", fields: [parentQuoteId], references: [id])

  childQuotes TransportQuote[] @relation("TransportQuoteChain")

  counterAmount Decimal? @db.Decimal(18, 2)

  // REQUESTER = arranging party most recently countered.
  // PROVIDER  = truck owner most recently countered.
  counteredBy QuoteCounterParty?

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transportJobId])
  @@index([truckOwnerId])
  @@index([truckId])
  @@index([status])
  @@index([parentQuoteId])
  @@index([expiresAt])
}

// ============================================================================
// DIGITAL PRODUCT
// ============================================================================

model DigitalProduct {
  id String @id @default(uuid())

  seller   User   @relation(fields: [sellerId], references: [id])
  sellerId String

  title       String
  productType String

  price Decimal @db.Decimal(18, 2)

  // Private object-storage key.
  fileKey String?

  fileName      String?
  mimeType      String?
  fileSizeBytes Int?

  // Legacy field retained for migration/reference.
  // Should not be exposed publicly.
  fileUrl String?

  description String?

  status ListingStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  digitalPurchases DigitalPurchase[]

  @@index([sellerId])
  @@index([status])
}


// ============================================================================
// REQUEST IDEMPOTENCY
// ============================================================================
// Optional request-level idempotency for state-changing API operations.
// A client may safely retry a request with the same key and scope without
// creating a second business mutation.

model IdempotencyRequest {
  id String @id @default(uuid())

  userId String
  scope String
  keyHash String
  requestHash String

  status String @default("PROCESSING")
  statusCode Int?
  response Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@unique([userId, scope, keyHash])
  @@index([expiresAt])
}

// ============================================================================
// PAYMENT OBLIGATION
// ============================================================================
//
// Durable financial obligation generated from an order workflow.
//
// IMPORTANT:
// The foreign key lives on Payment as Payment.obligationId.
// Therefore this model contains the inverse relation only:
//
//     payment Payment? @relation("PaymentObligationPayment")
//
// Do NOT add paymentId here.
// ============================================================================

model PaymentObligation {
  id String @id @default(uuid())

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  type PaymentType

  // Stable business key used to prevent duplicate obligations.
  obligationKey String @unique

  inspectionRequest   InspectionRequest? @relation(fields: [inspectionRequestId], references: [id], onDelete: SetNull)

  inspectionRequestId String?

  transportJob   TransportJob? @relation(fields: [transportJobId], references: [id], onDelete: SetNull)

  transportJobId String?

  payer User @relation("PaymentObligationPayer", fields: [payerId], references: [id])

  payerId String

  beneficiary User? @relation("PaymentObligationBeneficiary", fields: [beneficiaryId], references: [id])

  beneficiaryId String?

  amount Decimal @db.Decimal(18, 2)

  currency String @default("ETB")

  status PaymentObligationStatus @default(OPEN)

  // INVERSE SIDE of Payment.obligation.
  // The actual FK is Payment.obligationId.
  payment Payment? @relation("PaymentObligationPayment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, status])
  @@index([payerId, status])
  @@index([beneficiaryId])
  @@index([type])
  @@index([inspectionRequestId])
  @@index([transportJobId])
}

// ============================================================================
// ORDER EVENT
// ============================================================================
//
// Durable customer-facing workflow history.
// Separate from AuditEvent so users can see meaningful order progress
// without exposing internal audit information.
// ============================================================================

model OrderEvent {
  id String @id @default(uuid())

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  actor User? @relation("OrderEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  actorId String?

  type String

  fromStatus String?
  toStatus   String?

  metadata Json?

  createdAt DateTime @default(now())

  notifications Notification[]

  @@index([orderId, createdAt])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
}

// ============================================================================
// NOTIFICATION
// ============================================================================
//
// Durable in-app notifications generated from OrderEvent records.
// Notifications are intentionally separate from AuditEvent: users can act on
// them without exposing internal audit information.
// ============================================================================

model Notification {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  order   Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String?

  orderEvent   OrderEvent @relation(fields: [orderEventId], references: [id], onDelete: Cascade)
  orderEventId String

  type  String
  title String
  body  String

  // Optional client navigation target, e.g. { "path": "/orders/<id>" }.
  action   Json?
  metadata Json?

  readAt DateTime?

  createdAt DateTime @default(now())

  @@unique([orderEventId, userId])
  @@index([userId, readAt, createdAt])
  @@index([orderId, createdAt])
  @@index([orderEventId])
}

// ============================================================================
// PAYMENT
// ============================================================================

model Payment {
  id String @id @default(uuid())

  // --------------------------------------------------------------------------
  // MARKETPLACE / ORDER PAYMENT
  // --------------------------------------------------------------------------

  order   Order?  @relation(fields: [orderId], references: [id])
  orderId String?

  // --------------------------------------------------------------------------
  // USER WHO CREATED THE PAYMENT
  // --------------------------------------------------------------------------

  createdBy   User?  @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdById String?

  // --------------------------------------------------------------------------
  // DIGITAL PRODUCT PAYMENT
  // --------------------------------------------------------------------------

  digitalProduct   DigitalProduct? @relation(fields: [digitalProductId], references: [id])
  digitalProductId String?

  // --------------------------------------------------------------------------
  // ADVERTISING PAYMENT
  // --------------------------------------------------------------------------

  advertisement   Advertisement? @relation(fields: [advertisementId], references: [id])
  advertisementId String?

  // --------------------------------------------------------------------------
  // INSPECTION PAYMENT
  // --------------------------------------------------------------------------

  inspectionRequest   InspectionRequest? @relation(fields: [inspectionRequestId], references: [id])
  inspectionRequestId String?

  // --------------------------------------------------------------------------
  // TRANSPORT PAYMENT
  // --------------------------------------------------------------------------

  transportJob   TransportJob? @relation(fields: [transportJobId], references: [id])
  transportJobId String?

  // --------------------------------------------------------------------------
  // DIGITAL PURCHASE
  // --------------------------------------------------------------------------

  digitalPurchase DigitalPurchase?

  // --------------------------------------------------------------------------
  // PAYMENT OBLIGATION
  // --------------------------------------------------------------------------
  //
  // IMPORTANT:
  // Payment owns the foreign key.
  //
  // One Payment may satisfy one PaymentObligation.
  // One PaymentObligation may have at most one Payment.
  //
  // This is intentionally named so it matches:
  //
  // PaymentObligation.payment
  //
  // in the PaymentObligation model.
  // --------------------------------------------------------------------------

  obligation   PaymentObligation? @relation("PaymentObligationPayment", fields: [obligationId], references: [id])

  obligationId String? @unique

  // --------------------------------------------------------------------------
  // PAYMENT DATA
  // --------------------------------------------------------------------------

  type PaymentType

  amount Decimal @db.Decimal(18, 2)

  currency String @default("ETB")

  method PaymentMethod

  status PaymentStatus @default(PENDING)

  // Internal/reference supplied by MarketBridge.
  reference String?

  // Client-supplied idempotency key.
  idempotencyKey String? @unique

  // Payment provider.
  provider String?

  // Provider transaction reference.
  providerTransactionId String?

  // --------------------------------------------------------------------------
  // COMMISSION
  // --------------------------------------------------------------------------

  commissionRate Float?

  commissionAmount Decimal? @db.Decimal(18, 2)

  netAmount Decimal? @db.Decimal(18, 2)

  // --------------------------------------------------------------------------
  // TIMESTAMPS
  // --------------------------------------------------------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --------------------------------------------------------------------------
  // FINANCIAL RECORDS
  // --------------------------------------------------------------------------

  ledgerEntries PaymentLedgerEntry[]

  events PaymentEvent[]

  refunds PaymentRefund[]
  reconciliations PaymentReconciliation[]

  @@index([orderId])
  @@index([createdById])
  @@index([digitalProductId])
  @@index([inspectionRequestId])
  @@index([advertisementId])
  @@index([transportJobId])
  @@index([type])
  @@index([status])
  @@index([reference])

  // Allows providerTransactionId to be unique when present.
  // PostgreSQL permits multiple NULL values.
  @@unique([provider, providerTransactionId])
}

// ============================================================================
// PAYMENT LEDGER ENTRY
// ============================================================================

model PaymentLedgerEntry {
  id String @id @default(uuid())

  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId String

  // Recipient/beneficiary.
  // Null for platform-level entries.
  user   User?  @relation(fields: [userId], references: [id])
  userId String?

  type PaymentLedgerEntryType

  amount Decimal @db.Decimal(18, 2)

  currency String @default("ETB")

  description String?

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([userId])
  @@index([type])

  @@unique([paymentId, type])
}

// ============================================================================
// PAYMENT EVENT
// ============================================================================
//
// Stores provider/webhook events for idempotency and audit purposes.
// ============================================================================

model PaymentEvent {
  id String @id @default(uuid())

  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId String

  provider String

  eventId String

  status String

  payload Json

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([provider])
  @@index([createdAt])

  @@unique([provider, eventId])
}


// ============================================================================
// PAYMENT REFUND
// ============================================================================
// Refunds are durable financial instructions. A payment is not marked
// REFUNDED until the provider (or an authorized settlement process) confirms
// the refund. This prevents order cancellation from silently fabricating a
// completed refund.
// ============================================================================

model PaymentRefund {
  id String @id @default(uuid())

  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentId String

  requestedBy   User? @relation("PaymentRefundRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedById String?

  amount Decimal @db.Decimal(18, 2)
  currency String @default("ETB")
  reason String?
  status PaymentRefundStatus @default(REQUESTED)
  provider String?
  providerRefundId String?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?

  @@index([paymentId, status])
  @@index([status, createdAt])
  @@unique([provider, providerRefundId])
}

// ============================================================================
// PAYMENT RECONCILIATION
// ============================================================================

model PaymentReconciliation {
  id String @id @default(uuid())

  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId String

  provider String
  observedStatus String?
  expectedAmount Decimal @db.Decimal(18, 2)
  observedAmount Decimal? @db.Decimal(18, 2)
  expectedCurrency String
  observedCurrency String?
  reason String
  payload Json?

  status PaymentReconciliationStatus @default(OPEN)
  resolvedBy   User? @relation("PaymentReconciliationResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedById String?
  resolvedAt DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId, status])
  @@index([status, createdAt])
  @@index([provider, createdAt])
}

// ============================================================================
// DIGITAL PURCHASE
// ============================================================================

model DigitalPurchase {
  id String @id @default(uuid())

  product   DigitalProduct @relation(fields: [productId], references: [id])
  productId String

  buyer   User   @relation("DigitalPurchases", fields: [buyerId], references: [id])
  buyerId String

  payment   Payment @relation(fields: [paymentId], references: [id])
  paymentId String @unique

  status DigitalPurchaseStatus @default(PENDING)

  downloadCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, buyerId])
  @@index([buyerId])
  @@index([productId])
  @@index([status])
}

// ============================================================================
// ADVERTISEMENT
// ============================================================================

model Advertisement {
  id String @id @default(uuid())

  advertiser   User   @relation(fields: [advertiserId], references: [id])
  advertiserId String

  listing   Listing? @relation(fields: [listingId], references: [id])
  listingId String?

  type AdType

  status AdStatus @default(PENDING_PAYMENT)

  startDate DateTime
  endDate   DateTime

  // Server-calculated campaign price.
  priceQuoted Decimal @db.Decimal(18, 2)

  amountPaid Decimal? @db.Decimal(18, 2)

  currency String @default("ETB")

  campaignReference String @unique

  // Creative/destination metadata.
  headline         String?
  destinationUrl   String?
  creativeImageKey String?

  // Banner layout template.
  bannerTemplate BannerTemplate @default(CLASSIC)

  // Moderation/publication audit trail.
  rejectionReason       String?
  publishedAt           DateTime?
  telegramPostReference String?

  payments Payment[]

  events AdvertisementEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advertiserId])
  @@index([listingId])
  @@index([status])
  @@index([type, status, startDate, endDate])
  @@index([createdAt])
}

// ============================================================================
// ADVERTISEMENT EVENT
// ============================================================================

model AdvertisementEvent {
  id String @id @default(uuid())

  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  advertisementId String

  eventType AdvertisementEventType

  createdAt DateTime @default(now())

  @@index([advertisementId, eventType, createdAt])
}

// ============================================================================
// DISPUTE
// ============================================================================

model Dispute {
  id String @id @default(uuid())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  raisedBy   User   @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  raisedById String

  against   User   @relation("DisputeAgainst", fields: [againstId], references: [id])
  againstId String

  disputeType String

  description String

  evidence String[]

  status DisputeStatus @default(OPEN)

  resolution String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([raisedById])
  @@index([againstId])
  @@index([status])
}

// ============================================================================
// RATING
// ============================================================================

model Rating {
  id String @id @default(uuid())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  fromUser   User   @relation("RatingsGiven", fields: [fromUserId], references: [id])
  fromUserId String

  toUser   User   @relation("RatingsReceived", fields: [toUserId], references: [id])
  toUserId String

  role Role

  score Int

  comment String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([fromUserId])
  @@index([toUserId])

  @@unique([orderId, fromUserId, toUserId, role])
}

// ============================================================================
// MESSAGE
// ============================================================================

model Message {
  id String @id @default(uuid())

  order   Order?  @relation(fields: [orderId], references: [id])
  orderId String?

  sender   User   @relation("MessagesSent", fields: [senderId], references: [id])
  senderId String

  receiver   User   @relation("MessagesReceived", fields: [receiverId], references: [id])
  receiverId String

  content String

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([senderId])
  @@index([receiverId])
}
