{
  "name": "marketbridge-backend",
  "version": "1.0.0",
  "description": "MarketBridge API \u2014 Ethiopian agricultural & digital marketplace",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nodemon src/index.js",
    "start": "prisma migrate deploy && node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "docs:generate": "node scripts/generate-openapi.js",
    "predev": "npm run docs:generate",
    "prestart": "npm run docs:generate",
    "backup": "bash scripts/backup-postgres.sh",
    "restore": "bash scripts/restore-postgres.sh",
    "backup:list": "node scripts/backupStorage.js list"
  },
  "dependencies": {
    "swagger-ui-express": "^5.0.1",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@prisma/client": "^5.19.1",
    "@sentry/node": "^8.42.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.1",
    "ioredis": "^5.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.3",
    "prisma": "^5.19.1",
    "nodemailer": "^6.9.16",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "pino-pretty": "^11.2.2"
  }
}
