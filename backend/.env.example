# MarketBridge backend — environment variables.
#
# Vars marked (required in production) are enforced by validateEnv() in
# src/index.js: the server refuses to boot in production if any are missing.
# Everything else has a safe default or is only needed to enable a specific
# feature (S3 uploads, Redis-backed rate limiting, SMS).

# --- Core ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/marketbridge   # required in production
LOG_LEVEL=info

# --- Auth / sessions ------------------------------------------------------
JWT_SECRET=                    # required in production, 32+ chars
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m

# --- URLs -------------------------------------------------------------
CLIENT_URL=http://localhost:5173      # required in production; comma-separated allow-list
APP_BASE_URL=http://localhost:5173    # required in production; used to build reset-password links
API_BASE_URL=http://localhost:3000    # required in production

# --- Payments (Chapa / Telebirr) ---------------------------------------
CHAPA_SECRET_KEY=              # required in production
CHAPA_WEBHOOK_SECRET=          # required in production, 32+ chars
PAYMENT_WEBHOOK_SECRET=        # required in production, 32+ chars — generic webhook HMAC
ORDER_PAYMENT_TIMEOUT_HOURS=

# --- Transactional email (password reset) -------------------------------
# Any SMTP provider works (SES SMTP, SendGrid SMTP, Mailgun, etc.).
# Outside production, a missing config logs the email instead of sending.
SMTP_HOST=                     # required in production
SMTP_PORT=587                  # required in production
SMTP_USER=                     # required in production
SMTP_PASS=                     # required in production
MAIL_FROM=                     # required in production
SMTP_SECURE=

# --- SMS (order/payment notifications) ----------------------------------
SMS_PROVIDER=
AFROMESSAGE_API_KEY=
AFROMESSAGE_SENDER_ID=

# --- Object storage (banner/listing/digital-product uploads) ------------
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
MEDIA_SIGNED_URL_EXPIRES_SECONDS=
DIGITAL_DOWNLOAD_EXPIRES_SECONDS=

# --- Redis (rate limiting) ------------------------------------------------
REDIS_URL=
REDIS_TLS=
REDIS_CONNECT_TIMEOUT_MS=

# --- Background jobs ------------------------------------------------------
MARKETBRIDGE_JOBS_ENABLED=
MARKETBRIDGE_JOB_INTERVAL_MS=

# --- Metrics endpoint -----------------------------------------------------
METRICS_TOKEN=

# --- Commission rates -----------------------------------------------------
MARKETPLACE_COMMISSION_RATE=0.05
TRANSPORT_COMMISSION_RATE=0.05
INSPECTION_COMMISSION_RATE=0.05

# --- Image processing limits (all have code defaults; override if needed) -
IMAGE_MAX_INPUT_PIXELS=
LISTING_IMAGE_MAX_WIDTH=
LISTING_IMAGE_MAX_HEIGHT=
LISTING_IMAGE_QUALITY=
AD_IMAGE_MAX_WIDTH=
AD_IMAGE_MAX_HEIGHT=
AD_IMAGE_QUALITY=
AD_BANNER_MAX_FILE_BYTES=
AD_MAX_CAMPAIGN_DAYS=
DIGITAL_IMAGE_MAX_WIDTH=
DIGITAL_IMAGE_MAX_HEIGHT=
DIGITAL_IMAGE_QUALITY=
DIGITAL_MAX_FILE_BYTES=
EVIDENCE_IMAGE_MAX_WIDTH=
EVIDENCE_IMAGE_MAX_HEIGHT=
EVIDENCE_IMAGE_QUALITY=
EVIDENCE_MAX_FILES=
EVIDENCE_MAX_FILE_BYTES=
